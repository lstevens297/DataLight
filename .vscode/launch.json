{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Run DataLight Extension",
      "type": "extensionHost",
      "request": "launch",
      "runtimeExecutable": "${execPath}",
      "args": [
        "--extensionDevelopmentPath=${workspaceFolder}"
      ],
      "outFiles": [
        "${workspaceFolder}/dist/src/**/*.js"
      ],
      "preLaunchTask": "compile"
    }
  ]
}
